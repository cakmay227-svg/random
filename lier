local function getPath(inst)
	local path = {}
	while inst do
		table.insert(path, 1, inst.Name)
		inst = inst.Parent
	end
	return table.concat(path, ".")
end

local targetHue, targetSat = Color3.fromRGB(190, 255, 173):ToHSV()

for _, inst in ipairs(model:GetDescendants()) do
	print(("[%s] %s"):format(inst.ClassName, getPath(inst)))

	if inst:IsA("BasePart") then
		local _, _, v = inst.Color:ToHSV()
		inst.Color = Color3.fromHSV(targetHue, targetSat, v)

	elseif inst:IsA("ParticleEmitter") then
		local isDepthEmitter =
			inst.Name == "ParticleEmitter"
			and inst.Parent
			and inst.Parent.Name == "Attachment"
			and inst.Parent.Parent
			and inst.Parent.Parent.Name == "Depth"
			and inst.Parent.Parent.Parent == model

		if isDepthEmitter then
			inst.Texture = "rbxassetid://124060873827863"
		else
			local keypoints = {}

			for _, kp in ipairs(inst.Color.Keypoints) do
				local _, _, v = kp.Value:ToHSV()

				keypoints[#keypoints + 1] = ColorSequenceKeypoint.new(
					kp.Time,
					Color3.fromHSV(targetHue, targetSat, v)
				)
			end

			inst.Color = ColorSequence.new(keypoints)
		end

	elseif inst:IsA("PointLight")
		or inst:IsA("SpotLight")
		or inst:IsA("SurfaceLight") then

		local _, _, v = inst.Color:ToHSV()
		inst.Color = Color3.fromHSV(targetHue, targetSat, v)

	elseif inst:IsA("ImageLabel")
		or inst:IsA("ImageButton") then

		local _, _, v = inst.ImageColor3:ToHSV()
		inst.ImageColor3 = Color3.fromHSV(targetHue, targetSat, v)

	elseif inst:IsA("Decal")
		or inst:IsA("Texture") then

		local _, _, v = inst.Color3:ToHSV()
		inst.Color3 = Color3.fromHSV(targetHue, targetSat, v)
	end
end

