local SoundCache = {}

function GitAud(url, filename)
	local path = filename .. ".mp3"

	if SoundCache[path] then
		return SoundCache[path]
	end

	if not isfile(path) then
		writefile(path, game:HttpGet(url))
	end

	local asset = (getcustomasset or getsynasset)(path)

	SoundCache[path] = asset

	return asset
end

function CustomGitSound(url, _, filename)
	local sound = Instance.new("Sound")

	sound.SoundId = GitAud(url, filename)
	sound.Parent = workspace
	sound.Name = "Fcvvvbh"
	sound.PlaybackSpeed = 1
	sound.Volume = 3

	sound:Play()

	return sound
end

