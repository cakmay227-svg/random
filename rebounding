local LatestRoom = game.ReplicatedStorage.GameData.LatestRoom

local maxSpawns = math.random(3,6)
local spawned = 0

task.spawn(function()
	while spawned < maxSpawns do
		LatestRoom.Changed:Wait()

		spawned += 1
		spawnCount += 1
		
		task.wait(0.3)

		SpawnRebound()

		print(("Spawn %d/%d"):format(spawned, maxSpawns))
	end
end)
